---
import Container from "@/components/ui/Container.astro";
import VerificationForm from "@/components/forms/VerificationForm.vue";
import Layout from "@/layouts/Layout.astro";
import Inscription from "@/components/Inscription.astro";
---

<Layout>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 lg:gap-6">
      <Inscription />

      <!-- <div class="text-center">
        <h2 class="text-3xl md:text-5xl mb-4 text-gradient font-bold">
          REGISTRO
        </h2>
      </div> -->

      <VerificationForm client:idle />
    </div>
  </Container>
</Layout>

<style>
  @keyframes slow-ping {
    75%,
    100% {
      transform: scale(1.2);
      opacity: 0;
    }
  }

  .animate-slow-ping {
    animation: slow-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>
