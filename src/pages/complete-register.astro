---
import Layout from "@/layouts/Layout.astro";
import RegistrationForm from "@/components/forms/RegistrationForm.vue";
import AbortRegistration from "@/components/forms/AbortRegistration.astro";
import Container from "@/components/ui/Container.astro";

const email = Astro.locals.email as string | undefined;

if (!email) {
  return Astro.redirect("/register");
}
---

<Layout title="Completar Registro">
  <Container>
    <div class="mb-20">
      <div class="text-center pt-10 mb-10 px-4">
        <h2 class="text-3xl md:text-5xl text-white/80 font-bold">
          Formulario de <span class="text-gradient">registro</span>
        </h2>

        <div
          class="max-w-2xl mx-auto mt-6 p-4 bg-yellow-100 border border-yellow-300 rounded-lg"
        >
          <p class="text-yellow-900 font-medium text-center">
            Por favor, asegúrate de que tus datos sean correctos. <br />
            <strong
              >Los datos ingresados serán usados como datos oficiales para
              generar los certificados de acreditación del CINCIT 2025.</strong
            >
          </p>
        </div>
      </div>

      <RegistrationForm email={email} client:load />

      <AbortRegistration />
    </div>
  </Container>
</Layout>
